pipeline {
    agent any
    
    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Create Lambda Zip') {
            steps {
                script {
                    // Check if the lambda-code directory exists before zipping
                    def lambdaCodeDir = './devopsexam2025/lambda-code'
                    if (fileExists(lambdaCodeDir)) {
                        // Zip the Lambda function code if the directory exists
                        sh "zip -r lambda.zip ${lambdaCodeDir}/*"
                    } else {
                        error "Lambda code directory does not exist at: ${lambdaCodeDir}"
                    }
                }
            }
        }

        stage('TF Init') {
            steps {
                script {
                    dir('devopsexam2025') {
                        sh 'terraform init'
                    }
                }
            }
        }

        stage('TF Validate') {
            steps {
                script {
                    dir('devopsexam2025') {
                        sh 'terraform validate'
                    }
                }
            }
        }

        stage('TF Plan') {
            steps {
                script {
                    dir('devopsexam2025') {
                        sh 'terraform plan'
                    }
                }
            }
        }

        stage('TF Apply') {
            steps {
                script {
                    dir('devopsexam2025') {
                        sh 'terraform apply -auto-approve'
                    }
                }
            }
        }
    }
}
