pipeline {
    agent any
    
    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Create Lambda Zip') {
            steps {
                script {
                    // Create the lambda.zip file from the Lambda source code
                    sh 'zip -r lambda.zip ./devopsexam2025/lambda-code/*'
                }
            }
        }

        stage('TF Init') {
            steps {
                script {
                    dir('devopsexam2025') {
                        sh 'terraform init'
                    }
                }
            }
        }

        stage('TF Validate') {
            steps {
                script {
                    dir('devopsexam2025') {
                        sh 'terraform validate'
                    }
                }
            }
        }

        stage('TF Plan') {
            steps {
                script {
                    dir('devopsexam2025') {
                        sh 'terraform plan'
                    }
                }
            }
        }

        stage('TF Apply') {
            steps {
                script {
                    dir('devopsexam2025') {
                        sh 'terraform apply -auto-approve'
                    }
                }
            }
        }
    }
}
